{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "built_up_axial_member_guided_case.schema.json",
  "title": "SP16 Stage N3 guided built-up axial member",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action", "force_state", "axial_force_n",
    "gross_area_mm2", "total_net_area_mm2", "section_weakening",
    "normative_yield_resistance_n_mm2", "design_yield_resistance_n_mm2",
    "design_ultimate_resistance_n_mm2", "ultimate_resistance_safety_factor",
    "elastic_modulus_n_mm2", "working_condition_factor", "post_yield_service_possible"
  ],
  "properties": {
    "case_id":{"type":"string"},
    "standard":{"type":"string","const":"СП 16.13330.2017"},
    "action":{"type":"string","const":"built_up_axial_member_guided"},
    "force_state":{"type":"string","enum":["tension","compression"]},
    "axial_force_n":{"type":"number","minimum":0},
    "section_weakening":{"type":"string","enum":["none","explicit_net_area"]},
    "gross_area_mm2":{"type":"number","exclusiveMinimum":0},
    "total_net_area_mm2":{"type":"number","exclusiveMinimum":0},
    "normative_yield_resistance_n_mm2":{"type":"number","minimum":0},
    "design_yield_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},
    "design_ultimate_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},
    "ultimate_resistance_safety_factor":{"type":"number","exclusiveMinimum":0},
    "elastic_modulus_n_mm2":{"type":"number","exclusiveMinimum":0},
    "working_condition_factor":{"type":"number","exclusiveMinimum":0},
    "post_yield_service_possible":{"type":"boolean"},
    "panel_count":{"type":"integer","minimum":1},
    "connector_system":{"type":"string","enum":["battens","lattice"]},
    "built_up_section_type":{"type":"integer","minimum":1,"maximum":3},
    "table8_data":{"type":"object"},
    "branch_relative_slenderness":{"type":"number","minimum":0},
    "branch_section_type":{"type":"string","enum":["a","b","c"]},
    "close_contact_check":{"type":"object"},
    "connector_force_check":{"type":"object"}
  }
}
