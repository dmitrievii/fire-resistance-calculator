{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axial_member_case.schema.json",
  "title": "SP 16 v0.4 axial member strength and stability case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "standard",
    "action",
    "axial_force_n",
    "net_area_mm2",
    "gross_area_mm2",
    "design_yield_resistance_n_mm2",
    "design_ultimate_resistance_n_mm2",
    "ultimate_resistance_safety_factor",
    "working_condition_factor",
    "equation_5_resistance_branch",
    "geometric_slenderness",
    "elastic_modulus_n_mm2",
    "section_type",
    "angle_table_6_case",
    "angle_attached_leg_net_strip_area_mm2",
    "angle_steel_yield_strength_n_mm2",
    "single_angle_clause_7_1_2_applicability_confirmed",
    "table_6_geometry_case_confirmed",
    "special_ten_percent_reduction_applies"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017"
    },
    "action": {
      "type": "string",
      "const": "axial_member_strength_and_stability"
    },
    "axial_force_n": {
      "type": "number",
      "minimum": 0
    },
    "net_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "gross_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "design_yield_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "design_ultimate_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "ultimate_resistance_safety_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "working_condition_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "equation_5_resistance_branch": {
      "type": "string",
      "enum": [
        "yield",
        "ultimate"
      ]
    },
    "geometric_slenderness": {
      "type": "number",
      "minimum": 0
    },
    "elastic_modulus_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "section_type": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c"
      ]
    },
    "angle_table_6_case": {
      "type": "string",
      "enum": [
        "one_bolt_a_1_35d",
        "one_bolt_a_1_5d",
        "one_bolt_a_2d",
        "multi_bolt_2",
        "multi_bolt_3",
        "multi_bolt_4"
      ]
    },
    "angle_attached_leg_net_strip_area_mm2": {
      "type": "number",
      "minimum": 0
    },
    "angle_steel_yield_strength_n_mm2": {
      "type": "number",
      "minimum": 0,
      "maximum": 380
    },
    "single_angle_clause_7_1_2_applicability_confirmed": {
      "type": "boolean",
      "const": true
    },
    "table_6_geometry_case_confirmed": {
      "type": "boolean",
      "const": true
    },
    "special_ten_percent_reduction_applies": {
      "type": "boolean"
    }
  }
}
