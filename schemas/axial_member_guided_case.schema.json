{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axial_member_guided_case.schema.json",
  "title": "SP16 Stage N3 guided solid axial member",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action", "force_state", "axial_force_n",
    "gross_area_mm2", "net_area_mm2", "section_weakening",
    "normative_yield_resistance_n_mm2", "design_yield_resistance_n_mm2",
    "design_ultimate_resistance_n_mm2", "ultimate_resistance_safety_factor",
    "elastic_modulus_n_mm2", "working_condition_factor", "post_yield_service_possible"
  ],
  "properties": {
    "case_id": {"type":"string"},
    "standard": {"type":"string", "const":"СП 16.13330.2017"},
    "action": {"type":"string", "const":"axial_member_guided"},
    "force_state": {"type":"string", "enum":["tension","compression"]},
    "axial_force_n": {"type":"number", "minimum":0},
    "section_weakening": {"type":"string", "enum":["none","explicit_net_area"]},
    "gross_area_mm2": {"type":"number", "exclusiveMinimum":0},
    "net_area_mm2": {"type":"number", "exclusiveMinimum":0},
    "normative_yield_resistance_n_mm2": {"type":"number", "minimum":0},
    "design_yield_resistance_n_mm2": {"type":"number", "exclusiveMinimum":0},
    "design_ultimate_resistance_n_mm2": {"type":"number", "exclusiveMinimum":0},
    "ultimate_resistance_safety_factor": {"type":"number", "exclusiveMinimum":0},
    "elastic_modulus_n_mm2": {"type":"number", "exclusiveMinimum":0},
    "working_condition_factor": {"type":"number", "exclusiveMinimum":0},
    "post_yield_service_possible": {"type":"boolean"},
    "effective_length_mm": {"type":"number", "minimum":0},
    "radius_of_gyration_mm": {"type":"number", "exclusiveMinimum":0},
    "section_type": {"type":"string", "enum":["a","b","c"]},
    "local_stability_prerequisites_satisfied": {"type":"boolean"},
    "stability_formula": {"type":"string", "enum":["equation_7","equation_7a_rolled_i","both"]},
    "rolled_i_section_confirmed": {"type":"boolean"},
    "single_angle_clause_7_1_2": {
      "type":"object",
      "additionalProperties": false,
      "required":["applicability_confirmed","table_6_geometry_case_confirmed","table_6_case","attached_leg_net_strip_area_mm2","special_ten_percent_reduction_applies"],
      "properties": {
        "applicability_confirmed":{"type":"boolean"},
        "table_6_geometry_case_confirmed":{"type":"boolean"},
        "table_6_case":{"type":"string","enum":["one_bolt_a_1_35d","one_bolt_a_1_5d","one_bolt_a_2d","multi_bolt_2","multi_bolt_3","multi_bolt_4"]},
        "attached_leg_net_strip_area_mm2":{"type":"number","minimum":0},
        "special_ten_percent_reduction_applies":{"type":"boolean"}
      }
    }
  }
}
