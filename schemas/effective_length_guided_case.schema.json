{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "effective_length_guided_case.schema.json",
  "title": "SP16 Stage N7 guided effective-length and limiting-slenderness case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id","standard","action","effective_length_route","radius","limiting_slenderness"],
  "properties": {
    "case_id": {"type":"string","minLength":1},
    "standard": {"type":"string","const":"СП 16.13330.2017"},
    "action": {"type":"string","const":"effective_length_guided"},
    "effective_length_route": {
      "type":"object",
      "additionalProperties": false,
      "required":["kind"],
      "properties": {
        "kind":{"type":"string","enum":[
          "eq136_truss_chord_in_plane","eq137_truss_chord_out_of_plane","eq138_built_up_branch_in_plane","eq139_built_up_branch_out_of_plane",
          "table24_truss_member","table25_cross_lattice","table26_structural_member","table27_29_spatial_member","table30_column","table31_frame_column",
          "out_of_plane_column_10_3_9","gallery_support_10_3_10","stepped_column_10_3_7_external","certified_software_10_3_11","crossing_brace_external_10_1_3"
        ]},
        "segment_length_mm":{"type":"number","exclusiveMinimum":0},
        "adjacent_force_ratio_alpha":{"type":"number"},
        "braced_length_mm":{"type":"number","exclusiveMinimum":0},
        "section_count_k":{"type":"integer","minimum":2},
        "other_force_sum_ratio_beta":{"type":"number"},
        "geometric_length_mm":{"type":"number","exclusiveMinimum":0},
        "out_of_plane_braced_length_mm":{"type":"number","exclusiveMinimum":0},
        "table24_case":{"type":"string"},
        "member_role":{"type":"string"},
        "joint_case":{"type":"string"},
        "supporting_state":{"type":"string"},
        "node_to_intersection_length_mm":{"type":"number","exclusiveMinimum":0},
        "full_member_length_mm":{"type":"number","exclusiveMinimum":0},
        "member_case":{"type":"string"},
        "geometric_slenderness_l_over_i_min":{"type":"number","exclusiveMinimum":0},
        "is_lattice_member":{"type":"boolean"},
        "is_beam_column":{"type":"boolean"},
        "bending_plane_relation":{"type":"string"},
        "table27_row":{"type":"string"},
        "force_state":{"type":"string"},
        "base_lengths_mm":{"type":"object","additionalProperties":{"type":"number","exclusiveMinimum":0}},
        "chord_min_inertia_mm4":{"type":"number","exclusiveMinimum":0},
        "diagonal_length_mm":{"type":"number","exclusiveMinimum":0},
        "diagonal_min_inertia_mm4":{"type":"number","exclusiveMinimum":0},
        "chord_panel_length_mm":{"type":"number","exclusiveMinimum":0},
        "alternate_diagonal_length_mm":{"type":"number","exclusiveMinimum":0},
        "table28_joint_case":{"type":"string"},
        "connection_case":{"type":"string"},
        "gusset_configuration":{"type":"string"},
        "out_of_plane_variant":{"type":"boolean"},
        "scheme_id":{"type":"string"},
        "column_length_mm":{"type":"number","exclusiveMinimum":0},
        "same_load_combination_confirmed":{"type":"boolean"},
        "mu_method":{"type":"string","enum":["eq141_sway_p0","eq142_sway_p_inf","eq143_sway_n_le_0_2","eq144_sway_n_gt_0_2","eq145_nonsway","table31_special_case"]},
        "n_parameter":{"type":"number","minimum":0},
        "p_parameter":{"type":"number","minimum":0},
        "special_case_id":{"type":"string"},
        "special_case_parameter":{"type":"number","exclusiveMinimum":0},
        "apply_eq146_nonuniform_loading":{"type":"boolean"},
        "checked_column_inertia_mm4":{"type":"number","exclusiveMinimum":0},
        "total_column_force_n":{"type":"number","exclusiveMinimum":0},
        "checked_column_force_n":{"type":"number","exclusiveMinimum":0},
        "total_column_inertia_mm4":{"type":"number","exclusiveMinimum":0},
        "apply_eq147_deformation_reduction":{"type":"boolean"},
        "relative_slenderness":{"type":"number","minimum":0},
        "moment_n_mm":{"type":"number","exclusiveMinimum":0},
        "nonsway_reference_moment_n_mm":{"type":"number"},
        "area_mm2":{"type":"number","exclusiveMinimum":0},
        "axial_force_n":{"type":"number","exclusiveMinimum":0},
        "compressed_fibre_section_modulus_mm3":{"type":"number","exclusiveMinimum":0},
        "frame_total_height_mm":{"type":"number","exclusiveMinimum":0},
        "frame_width_mm":{"type":"number","exclusiveMinimum":0},
        "global_frame_stability_confirmed":{"type":"boolean"},
        "use_restraint_spacing":{"type":"boolean"},
        "restraint_spacing_mm":{"type":"number","exclusiveMinimum":0},
        "direction":{"type":"string","enum":["longitudinal","transverse"]},
        "support_height_mm":{"type":"number","exclusiveMinimum":0},
        "node_spacing_mm":{"type":"number","exclusiveMinimum":0},
        "mu":{"type":"number","exclusiveMinimum":0},
        "overall_built_up_cantilever_stability_confirmed":{"type":"boolean"},
        "certified_software_confirmed":{"type":"boolean"},
        "elastic_steel_confirmed":{"type":"boolean"},
        "undeformed_scheme_confirmed":{"type":"boolean"},
        "external_effective_length":{
          "type":"object","additionalProperties":false,"required":["value_mm","basis"],
          "properties":{"value_mm":{"type":"number","exclusiveMinimum":0},"basis":{"type":"string","minLength":1}}
        }
      }
    },
    "radius": {
      "type":"object","additionalProperties":false,"required":["mode"],
      "properties":{
        "mode":{"type":"string","enum":["explicit","selector_values","single_angle_10_1_4"]},
        "value_mm":{"type":"number","exclusiveMinimum":0},
        "selector":{"type":"string","enum":["i_min","i_x","i_y"]},
        "i_min_mm":{"type":"number","exclusiveMinimum":0},
        "i_x_mm":{"type":"number","exclusiveMinimum":0},
        "i_y_mm":{"type":"number","exclusiveMinimum":0},
        "node_spacing_mm":{"type":"number","exclusiveMinimum":0},
        "buckling_direction":{"type":"string","enum":["perpendicular_to_truss_plane","parallel_to_truss_plane"]}
      }
    },
    "limiting_slenderness": {
      "type":"object","additionalProperties":false,"required":["mode","group_4_applies"],
      "properties":{
        "mode":{"type":"string","enum":["none","compressed_table32","tension_table33"]},
        "group_4_applies":{"type":"boolean"},
        "same_stability_case_confirmed":{"type":"boolean"},
        "axial_force_n":{"type":"number","minimum":0},
        "stability_coefficient_phi":{"type":"number","exclusiveMinimum":0,"maximum":1},
        "gross_area_mm2":{"type":"number","exclusiveMinimum":0},
        "design_yield_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},
        "working_condition_factor":{"type":"number","exclusiveMinimum":0},
        "table32_row":{"type":"string","enum":["1a","1b","2a","2b","3","4","5","6","7"]},
        "table33_row":{"type":"string","enum":["1","2","3","4","5","6","7","8"]},
        "load_category":{"type":"string","enum":["dynamic","static","crane_or_rail"]},
        "low_self_weight_sag_for_row_5":{"type":"boolean"},
        "crane_modes_1k_to_6k_for_row_3":{"type":"boolean"},
        "prestressed_tension_member":{"type":"boolean"}
      }
    }
  }
}
