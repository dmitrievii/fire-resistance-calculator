{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brittle_fracture_and_welded_connections_case.schema.json",
  "title": "SP 16.13330.2017 Sections 13 and 14.1 case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action",
    "connection_form_case", "plate_thickness_mm", "risk_weld_leg_mm", "restraint_level",
    "pass_count", "weld_sequence", "preheat", "through_thickness_action",
    "construction_group", "consequence_class", "flange_connection_or_normal_force", "selected_z_quality_group",
    "table38_connection_type", "thicker_element_thickness_mm", "thinner_element_thickness_mm", "steel_yield_strength_n_mm2",
    "table39_welding_process", "table39_weld_position", "fillet_weld_leg_mm",
    "weld_metal_resistance_n_mm2", "fusion_boundary_resistance_n_mm2", "working_condition_factor",
    "butt_axial_force_n", "butt_thickness_mm", "butt_full_length_mm", "butt_runout_tabs_used", "butt_design_resistance_n_mm2",
    "butt_sigma_x_n_mm2", "butt_sigma_y_n_mm2", "butt_tau_xy_n_mm2", "butt_yield_resistance_n_mm2", "butt_shear_resistance_n_mm2",
    "fillet_axial_force_n", "fillet_segment_lengths_mm", "fillet_out_of_plane_moment_n_mm", "fillet_in_plane_moment_n_mm",
    "weld_metal_section_modulus_mm3", "fusion_section_modulus_mm3", "weld_x_mm", "weld_y_mm",
    "weld_metal_inertia_x_mm4", "weld_metal_inertia_y_mm4", "fusion_inertia_x_mm4", "fusion_inertia_y_mm4",
    "tau_n_n_mm2", "tau_mx_n_mm2", "tau_v_n_mm2", "tau_my_n_mm2",
    "spot_first_thickness_mm", "spot_second_thickness_mm", "spot_diameter_mm",
    "normative_weld_metal_ultimate_resistance_n_mm2", "normative_connected_steel_ultimate_resistance_n_mm2",
    "engineering_classifications_confirmed"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "standard": {"const": "СП 16.13330.2017"},
    "action": {"const": "brittle_fracture_and_welded_connections"},
    "connection_form_case": {"type": "string", "minLength": 1},
    "plate_thickness_mm": {"type": "number", "minimum": 0},
    "risk_weld_leg_mm": {"type": "number", "minimum": 0},
    "restraint_level": {"type": "string", "minLength": 1},
    "pass_count": {"enum": ["one", "multiple"]},
    "weld_sequence": {"enum": ["alternating_sides", "one_side_then_other"]},
    "preheat": {"enum": ["without_preheat", "with_preheat"]},
    "through_thickness_action": {"enum": ["none", "static_compression", "dynamic_or_vibratory"]},
    "construction_group": {"type": "integer", "minimum": 1, "maximum": 4},
    "consequence_class": {"enum": ["KS-1", "KS-2", "KS-3"]},
    "flange_connection_or_normal_force": {"type": "boolean"},
    "selected_z_quality_group": {"enum": ["Z15", "Z25", "Z35"]},
    "table38_connection_type": {"enum": ["double_sided_t_lap_or_corner", "single_sided_corner_or_t"]},
    "thicker_element_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "thinner_element_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "steel_yield_strength_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "table39_welding_process": {"type": "string", "minLength": 1},
    "table39_weld_position": {"type": "string", "minLength": 1},
    "fillet_weld_leg_mm": {"type": "number", "exclusiveMinimum": 0},
    "weld_metal_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "fusion_boundary_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "working_condition_factor": {"type": "number", "exclusiveMinimum": 0},
    "butt_axial_force_n": {"type": "number"},
    "butt_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "butt_full_length_mm": {"type": "number", "exclusiveMinimum": 0},
    "butt_runout_tabs_used": {"type": "boolean"},
    "butt_design_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "butt_sigma_x_n_mm2": {"type": "number"},
    "butt_sigma_y_n_mm2": {"type": "number"},
    "butt_tau_xy_n_mm2": {"type": "number"},
    "butt_yield_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "butt_shear_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "fillet_axial_force_n": {"type": "number"},
    "fillet_segment_lengths_mm": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 10}},
    "fillet_out_of_plane_moment_n_mm": {"type": "number"},
    "fillet_in_plane_moment_n_mm": {"type": "number"},
    "weld_metal_section_modulus_mm3": {"type": "number", "exclusiveMinimum": 0},
    "fusion_section_modulus_mm3": {"type": "number", "exclusiveMinimum": 0},
    "weld_x_mm": {"type": "number"},
    "weld_y_mm": {"type": "number"},
    "weld_metal_inertia_x_mm4": {"type": "number", "exclusiveMinimum": 0},
    "weld_metal_inertia_y_mm4": {"type": "number", "exclusiveMinimum": 0},
    "fusion_inertia_x_mm4": {"type": "number", "exclusiveMinimum": 0},
    "fusion_inertia_y_mm4": {"type": "number", "exclusiveMinimum": 0},
    "tau_n_n_mm2": {"type": "number"},
    "tau_mx_n_mm2": {"type": "number"},
    "tau_v_n_mm2": {"type": "number"},
    "tau_my_n_mm2": {"type": "number"},
    "spot_first_thickness_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
    "spot_second_thickness_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
    "spot_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
    "normative_weld_metal_ultimate_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "normative_connected_steel_ultimate_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "engineering_classifications_confirmed": {"const": true}
  }
}
