{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structural detailing and support bearings case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action", "section_15_applicability_confirmed",
    "building_type", "direction", "design_air_temperature_c",
    "actual_temperature_block_distance_m", "frame_stiffness_increased_by_walls_or_other_structures",
    "paired_vertical_braces_present", "paired_vertical_brace_axis_spacing_m",
    "strict_uniform_pressure_distribution_required", "reaction_class",
    "relieve_substructure_from_horizontal_forces", "movable_bearing_type",
    "support_force_n", "hinge_contact_central_angle_deg", "hinge_radius_mm", "hinge_length_mm",
    "local_bearing_design_resistance_n_mm2", "roller_count", "roller_diameter_mm", "roller_length_mm",
    "roller_diametral_compression_resistance_n_mm2", "working_condition_factor"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "standard": {"type": "string", "const": "СП 16.13330.2017 «Стальные конструкции»"},
    "action": {"type": "string", "const": "structural_detailing_and_support_bearings"},
    "section_15_applicability_confirmed": {"type": "boolean", "const": true},
    "building_type": {"type": "string", "enum": ["heated_building", "unheated_building_or_hot_shop", "open_trestle"]},
    "direction": {"type": "string", "enum": ["between_joints_along_block", "between_joints_across_block", "joint_or_end_to_nearest_vertical_bracing_axis"]},
    "design_air_temperature_c": {"type": "number"},
    "actual_temperature_block_distance_m": {"type": "number", "minimum": 0},
    "frame_stiffness_increased_by_walls_or_other_structures": {"type": "boolean"},
    "paired_vertical_braces_present": {"type": "boolean"},
    "paired_vertical_brace_axis_spacing_m": {"type": "number", "minimum": 0},
    "strict_uniform_pressure_distribution_required": {"type": "boolean"},
    "reaction_class": {"type": "string", "enum": ["ordinary", "very_large"]},
    "relieve_substructure_from_horizontal_forces": {"type": "boolean"},
    "movable_bearing_type": {"type": "string", "enum": ["flat_sliding", "roller"]},
    "support_force_n": {"type": "number", "minimum": 0},
    "hinge_contact_central_angle_deg": {"type": "number", "minimum": 90},
    "hinge_radius_mm": {"type": "number", "exclusiveMinimum": 0},
    "hinge_length_mm": {"type": "number", "exclusiveMinimum": 0},
    "local_bearing_design_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "roller_count": {"type": "integer", "minimum": 1},
    "roller_diameter_mm": {"type": "number", "exclusiveMinimum": 0},
    "roller_length_mm": {"type": "number", "exclusiveMinimum": 0},
    "roller_diametral_compression_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "working_condition_factor": {"type": "number", "exclusiveMinimum": 0}
  }
}
