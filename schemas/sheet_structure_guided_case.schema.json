{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sheet_structure_guided_case.schema.json",
  "title": "SP16 Stage N8 guided Section 11 sheet-structure case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "standard", "action", "working_condition_factor", "design_yield_resistance_n_mm2", "elastic_modulus_n_mm2", "route"],
  "properties": {
    "case_id": {"type":"string","minLength":1},
    "standard": {"const":"СП 16.13330.2017"},
    "action": {"const":"sheet_structure_guided"},
    "working_condition_factor": {"type":"number","exclusiveMinimum":0},
    "design_yield_resistance_n_mm2": {"type":"number","exclusiveMinimum":0},
    "elastic_modulus_n_mm2": {"type":"number","exclusiveMinimum":0},
    "route": {
      "type":"object",
      "additionalProperties": false,
      "required":["kind"],
      "properties": {
        "kind": {"enum":[
          "membrane_general_11_1_1","axisymmetric_membrane_11_1_2","internal_pressure_cylinder_11_1_3","internal_pressure_sphere_11_1_3","internal_pressure_cone_11_1_3",
          "cylinder_axial_11_2_1","tube_11_2_2","cylindrical_panel_11_2_3","cylinder_external_pressure_11_2_4","cylinder_combined_11_2_5","cone_axial_11_2_6","cone_external_pressure_11_2_7","cone_combined_11_2_8","sphere_external_pressure_11_2_9"
        ]},
        "sigma_x_n_mm2":{"type":"number"},"sigma_y_n_mm2":{"type":"number"},"tau_xy_n_mm2":{"type":"number"},
        "tension_design_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},"compression_design_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},
        "perform_strength_check":{"type":"boolean"},
        "projected_pressure_force_n":{"type":"number"},"pressure_n_mm2":{"type":"number"},"external_pressure_n_mm2":{"type":"number","minimum":0},
        "radius_mm":{"type":"number","exclusiveMinimum":0},"thickness_mm":{"type":"number","exclusiveMinimum":0},"beta_degrees":{"type":"number","minimum":0,"maximum":60},
        "meridional_radius_mm":{"type":"number","exclusiveMinimum":0},"circumferential_radius_mm":{"type":"number","exclusiveMinimum":0},
        "has_geometry_thickness_or_load_discontinuity":{"type":"boolean"},"local_edge_effect_analysis_confirmed":{"type":"boolean"},
        "arbitrary_configuration_or_spatial_state":{"type":"boolean"},"certified_spatial_software_confirmed":{"type":"boolean"},"clauses_11_1_2_to_11_1_4_requirements_confirmed":{"type":"boolean"},
        "axial_compressive_stress_n_mm2":{"type":"number","minimum":0},"minimum_signed_stress_n_mm2":{"type":"number"},"shear_stress_n_mm2":{"type":"number"},"eccentric_compression_or_pure_bending":{"type":"boolean"},
        "external_table34_c":{"type":"object","additionalProperties":false,"required":["value","basis"],"properties":{"value":{"type":"number","exclusiveMinimum":0},"basis":{"type":"string","minLength":1}}},
        "relative_slenderness":{"type":"number","minimum":0},"sections_7_and_9_global_stability_confirmed":{"type":"boolean"},"axial_force_n":{"type":"number","minimum":0},"gross_area_mm2":{"type":"number","exclusiveMinimum":0},"relative_eccentricity_m":{"type":"number","minimum":0},
        "panel_width_mm":{"type":"number","exclusiveMinimum":0},"compressive_stress_n_mm2":{"type":"number","exclusiveMinimum":0},"shell_clause_11_2_1_confirmed":{"type":"boolean"},
        "length_mm":{"type":"number","exclusiveMinimum":0},"ring_stiffened":{"type":"boolean"},"ring_spacing_mm":{"type":"number","exclusiveMinimum":0},"ring_effective_area_mm2":{"type":"number","exclusiveMinimum":0},"ring_radius_of_gyration_mm":{"type":"number","exclusiveMinimum":0},"ring_table7_section_type":{"enum":["a","b","c"]},"ring_is_one_sided":{"type":"boolean"},"one_sided_ring_inertia_axis_confirmed":{"type":"boolean"},
        "top_radius_mm":{"type":"number","exclusiveMinimum":0},"bottom_radius_mm":{"type":"number","exclusiveMinimum":0},"height_mm":{"type":"number","exclusiveMinimum":0}
      }
    }
  }
}
