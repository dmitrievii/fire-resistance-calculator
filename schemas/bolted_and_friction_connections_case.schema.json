{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "СП 16.13330.2017 bolted and friction connections case",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "const": "СП 16.13330.2017"
    },
    "action": {
      "const": "bolted_and_friction_connections"
    },
    "sections_14_2_and_14_3_applicability_confirmed": {
      "const": true
    },
    "bolt_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "accuracy_class": {
      "enum": [
        "A",
        "B"
      ]
    },
    "special_class_b_structure": {
      "type": "boolean"
    },
    "hole_clearance_mm": {
      "type": "number",
      "minimum": 0
    },
    "outer_element_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "connected_steel_normative_yield_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "connected_steel_ultimate_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "layout_is_friction_connection": {
      "type": "boolean"
    },
    "layout_friction_planes": {
      "type": "integer",
      "minimum": 1
    },
    "edge_type": {
      "enum": [
        "cut",
        "rolled"
      ]
    },
    "stress_state": {
      "enum": [
        "tension",
        "compression"
      ]
    },
    "row_location": {
      "enum": [
        "edge_without_angles",
        "middle_or_edge_with_angles"
      ]
    },
    "transverse_row_spacing_mm": {
      "type": "number",
      "minimum": 0
    },
    "actual_center_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "actual_edge_along_force_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "actual_edge_transverse_force_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "multi_bolt_connection": {
      "type": "boolean"
    },
    "bearing_geometry": {
      "enum": [
        "standard",
        "a_1_5d_s_2d",
        "intermediate"
      ]
    },
    "bearing_interpolation_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "bolt_shear_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bearing_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bolt_tension_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "gross_bolt_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "net_thread_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shear_planes": {
      "type": "integer",
      "minimum": 1
    },
    "summed_bearing_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "working_condition_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "joint_length_along_shear_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "load_applied_over_full_joint_length": {
      "type": "boolean"
    },
    "bolted_connection_design_force_n": {
      "type": "number",
      "minimum": 0
    },
    "bolted_applicable_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "shear",
          "bearing",
          "tension"
        ]
      }
    },
    "bolt_coordinates_mm": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "group_force_x_n": {
      "type": "number"
    },
    "group_force_y_n": {
      "type": "number"
    },
    "group_moment_z_n_mm": {
      "type": "number"
    },
    "combined_bolt_shear_force_n": {
      "type": "number"
    },
    "combined_bolt_tension_force_n": {
      "type": "number"
    },
    "connection_detail": {
      "enum": [
        "none",
        "packing_or_single_cover_plate",
        "angle_or_channel_short_piece"
      ]
    },
    "surface_treatment": {
      "enum": [
        "shot_blast_no_preservation",
        "flame_cleaned_no_preservation",
        "steel_brushed_no_preservation",
        "untreated"
      ]
    },
    "tightening_control": {
      "enum": [
        "torque",
        "nut_rotation"
      ]
    },
    "friction_load_type": {
      "enum": [
        "dynamic",
        "static"
      ]
    },
    "friction_hole_clearance_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "friction_design_shear_force_n": {
      "type": "number",
      "minimum": 0
    },
    "friction_planes": {
      "type": "integer",
      "minimum": 1
    },
    "friction_tension_force_per_bolt_n": {
      "type": "number",
      "minimum": 0
    },
    "friction_summed_shifted_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "enlarged_head_and_nut": {
      "type": "boolean"
    },
    "gross_connected_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "net_connected_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  },
  "required": [
    "case_id",
    "standard",
    "action",
    "sections_14_2_and_14_3_applicability_confirmed",
    "bolt_diameter_mm",
    "accuracy_class",
    "special_class_b_structure",
    "hole_clearance_mm",
    "outer_element_thickness_mm",
    "connected_steel_normative_yield_resistance_n_mm2",
    "connected_steel_ultimate_resistance_n_mm2",
    "layout_is_friction_connection",
    "layout_friction_planes",
    "edge_type",
    "stress_state",
    "row_location",
    "transverse_row_spacing_mm",
    "actual_center_spacing_mm",
    "actual_edge_along_force_mm",
    "actual_edge_transverse_force_mm",
    "multi_bolt_connection",
    "bearing_geometry",
    "bearing_interpolation_fraction",
    "bolt_shear_resistance_n_mm2",
    "bearing_resistance_n_mm2",
    "bolt_tension_resistance_n_mm2",
    "gross_bolt_area_mm2",
    "net_thread_area_mm2",
    "shear_planes",
    "summed_bearing_thickness_mm",
    "working_condition_factor",
    "joint_length_along_shear_mm",
    "load_applied_over_full_joint_length",
    "bolted_connection_design_force_n",
    "bolted_applicable_modes",
    "bolt_coordinates_mm",
    "group_force_x_n",
    "group_force_y_n",
    "group_moment_z_n_mm",
    "combined_bolt_shear_force_n",
    "combined_bolt_tension_force_n",
    "connection_detail",
    "surface_treatment",
    "tightening_control",
    "friction_load_type",
    "friction_hole_clearance_mm",
    "friction_design_shear_force_n",
    "friction_planes",
    "friction_tension_force_per_bolt_n",
    "friction_summed_shifted_thickness_mm",
    "enlarged_head_and_nut",
    "gross_connected_area_mm2",
    "net_connected_area_mm2"
  ]
}
