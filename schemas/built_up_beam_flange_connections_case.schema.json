{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Built-up beam flange connections case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "standard",
    "action",
    "clause_14_4_applicability_confirmed",
    "transverse_shear_force_n",
    "flange_static_moment_mm3",
    "gross_section_moment_inertia_mm4",
    "concentrated_load_n",
    "load_factor_gamma_f",
    "local_load_factor_gamma_f1",
    "effective_distribution_length_mm",
    "nominal_load_character",
    "loaded_flange",
    "transverse_stiffener_at_load",
    "web_edge_planed_to_loaded_upper_flange",
    "weld_line_count",
    "weld_coefficient_beta_f",
    "weld_coefficient_beta_z",
    "weld_leg_mm",
    "weld_metal_design_resistance_n_mm2",
    "fusion_boundary_design_resistance_n_mm2",
    "working_condition_factor",
    "bolt_pitch_mm",
    "friction_plane_capacity_n",
    "friction_plane_count",
    "full_penetration_through_web_thickness",
    "sheet_section_force_capacity_n",
    "attachment_segment"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017 «Стальные конструкции»"
    },
    "action": {
      "type": "string",
      "const": "built_up_beam_flange_connections"
    },
    "clause_14_4_applicability_confirmed": {
      "type": "boolean",
      "const": true
    },
    "transverse_shear_force_n": {
      "type": "number"
    },
    "flange_static_moment_mm3": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "gross_section_moment_inertia_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "concentrated_load_n": {
      "type": "number",
      "minimum": 0
    },
    "load_factor_gamma_f": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "local_load_factor_gamma_f1": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "effective_distribution_length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nominal_load_character": {
      "type": "string",
      "enum": [
        "stationary",
        "moving"
      ]
    },
    "loaded_flange": {
      "type": "string",
      "enum": [
        "upper",
        "lower"
      ]
    },
    "transverse_stiffener_at_load": {
      "type": "boolean"
    },
    "web_edge_planed_to_loaded_upper_flange": {
      "type": "boolean"
    },
    "weld_line_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "weld_coefficient_beta_f": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "weld_coefficient_beta_z": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "weld_leg_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "weld_metal_design_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fusion_boundary_design_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "working_condition_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "bolt_pitch_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "friction_plane_capacity_n": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "friction_plane_count": {
      "type": "integer",
      "minimum": 1
    },
    "full_penetration_through_web_thickness": {
      "type": "boolean"
    },
    "sheet_section_force_capacity_n": {
      "type": "number",
      "minimum": 0
    },
    "attachment_segment": {
      "type": "string",
      "enum": [
        "beyond_theoretical_cutoff",
        "between_actual_and_previous_sheet_cutoff"
      ]
    }
  }
}
