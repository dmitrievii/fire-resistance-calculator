{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overhead-line and switchyard support case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "standard",
    "action",
    "section_16_applicability_confirmed",
    "structure_case",
    "table_45_case_id",
    "table_45_applied_to_node_connection",
    "length_mm",
    "chord_axis_spacing_mm",
    "height_mm",
    "upper_spacing_mm",
    "lower_spacing_mm",
    "moment_n_mm",
    "axial_force_n",
    "connection_beta",
    "first_order_midspan_moment_n_mm",
    "first_order_max_shear_n",
    "transverse_deflection_mm",
    "area_mm2",
    "reduced_slenderness",
    "elastic_modulus_n_mm2",
    "moment_x_n_mm",
    "moment_y_n_mm",
    "angle_member",
    "angle_connection",
    "c_over_b",
    "n_md_over_n_m",
    "brace_bolt_line_ratio",
    "figure_15_g_or_d",
    "welded_centering",
    "broken_wire_combination",
    "table_46_row_id",
    "table_46_measure",
    "actual_relative_deformation",
    "table_46_load_mode",
    "traverse_member",
    "panel_length_mm",
    "alternate_chord_length_mm",
    "actual_first_lower_brace_slenderness",
    "support_system",
    "actual_diaphragm_spacing_m",
    "diaphragm_at_concentrated_loads",
    "diaphragm_at_chord_breaks",
    "edge_distance_mm",
    "bolt_diameter_mm",
    "permanently_tensioned_single_bolt_element",
    "braces_on_both_sides_of_chord_leg",
    "splice_total_bolts",
    "splice_bolts_per_leg_each_side",
    "splice_rows_per_leg_each_side",
    "use_seven_bolt_exception",
    "polygonal_face_count",
    "polygonal_face_width_mm",
    "polygonal_wall_thickness_mm",
    "maximum_compressive_stress_n_mm2",
    "minimum_stress_n_mm2",
    "design_yield_resistance_n_mm2",
    "working_condition_factor",
    "external_loads_and_combinations_confirmed"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017 «Стальные конструкции»"
    },
    "action": {
      "type": "string",
      "const": "overhead_line_and_switchyard_supports"
    },
    "section_16_applicability_confirmed": {
      "type": "boolean",
      "const": true
    },
    "structure_case": {
      "type": "string",
      "enum": [
        "GROUP_1_SPECIAL_WELDED_CROSSING_OVER_60M",
        "GROUP_2_WELDED_VL_OR_HIGH_VOLTAGE_ORU_OR_KS_TENSION",
        "GROUP_3_ORU_UP_TO_330KV_OR_KS_SUPPORTING",
        "GROUP_4_AUXILIARY"
      ]
    },
    "table_45_case_id": {
      "type": "string",
      "enum": [
        "FREE_STANDING_FIRST_TWO_PANELS_WELDED_CHORD",
        "FREE_STANDING_FIRST_TWO_PANELS_BOLTED_CHORD",
        "FLAT_TRAVERSE_CHORD_DIRECT_TWO_OR_MORE_BOLTS",
        "FLAT_TRAVERSE_CHORD_ONE_BOLT_OR_GUSSET",
        "FLAT_TRAVERSE_DIAGONAL_OR_STRUT",
        "GUY_INTERMEDIATE_SUPPORT_NORMAL",
        "GUY_ANCHOR_OR_ANGLE_SUPPORT_NORMAL",
        "GUY_ANCHOR_OR_ANGLE_SUPPORT_EMERGENCY"
      ]
    },
    "table_45_applied_to_node_connection": {
      "type": "boolean"
    },
    "length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "chord_axis_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "upper_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "lower_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "moment_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "axial_force_n": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "connection_beta": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "first_order_midspan_moment_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "first_order_max_shear_n": {
      "type": "number",
      "minimum": 0
    },
    "transverse_deflection_mm": {
      "type": "number",
      "minimum": 0
    },
    "area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "reduced_slenderness": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "elastic_modulus_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "moment_x_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "moment_y_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "angle_member": {
      "type": "string",
      "enum": [
        "chord",
        "brace"
      ]
    },
    "angle_connection": {
      "type": "string",
      "enum": [
        "bolted",
        "welded"
      ]
    },
    "c_over_b": {
      "type": "number",
      "minimum": 0.4,
      "maximum": 0.66
    },
    "n_md_over_n_m": {
      "type": "number",
      "minimum": 0
    },
    "brace_bolt_line_ratio": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 0.6
    },
    "figure_15_g_or_d": {
      "type": "boolean"
    },
    "welded_centering": {
      "type": "string",
      "enum": [
        "centroids",
        "brace_axes_to_chord_heel"
      ]
    },
    "broken_wire_combination": {
      "type": "boolean"
    },
    "table_46_row_id": {
      "type": "string",
      "enum": [
        "VL_TERMINAL_OR_CORNER_ANCHOR_UNDER_60_ALONG_WIRES",
        "VL_ANCHOR_UNDER_60_ALONG_WIRES",
        "VL_INTERMEDIATE_EXCEPT_CROSSING_ALONG_OR_ACROSS",
        "VL_CROSSING_OVER_60_ALONG_WIRES",
        "SWITCHYARD_SUPPORT_ALONG_WIRES",
        "SWITCHYARD_SUPPORT_ACROSS_WIRES",
        "EQUIPMENT_SUPPORT_POST",
        "EQUIPMENT_BEAM"
      ]
    },
    "table_46_measure": {
      "type": "string",
      "enum": [
        "top_deviation",
        "vertical_span",
        "vertical_cantilever",
        "horizontal_span",
        "horizontal_cantilever"
      ]
    },
    "actual_relative_deformation": {
      "type": "number",
      "minimum": 0
    },
    "table_46_load_mode": {
      "type": "string",
      "enum": [
        "normal",
        "emergency",
        "erection"
      ]
    },
    "traverse_member": {
      "type": "string",
      "enum": [
        "chord_primary",
        "chord_alternate",
        "diagonal",
        "strut"
      ]
    },
    "panel_length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "alternate_chord_length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "actual_first_lower_brace_slenderness": {
      "type": "number",
      "minimum": 0
    },
    "support_system": {
      "type": "string",
      "enum": [
        "free_standing",
        "guyed"
      ]
    },
    "actual_diaphragm_spacing_m": {
      "type": "number",
      "minimum": 0
    },
    "diaphragm_at_concentrated_loads": {
      "type": "boolean"
    },
    "diaphragm_at_chord_breaks": {
      "type": "boolean"
    },
    "edge_distance_mm": {
      "type": "number",
      "minimum": 0
    },
    "bolt_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "permanently_tensioned_single_bolt_element": {
      "type": "boolean"
    },
    "braces_on_both_sides_of_chord_leg": {
      "type": "boolean"
    },
    "splice_total_bolts": {
      "type": "integer",
      "minimum": 2
    },
    "splice_bolts_per_leg_each_side": {
      "type": "integer",
      "minimum": 1
    },
    "splice_rows_per_leg_each_side": {
      "type": "integer",
      "minimum": 1
    },
    "use_seven_bolt_exception": {
      "type": "boolean"
    },
    "polygonal_face_count": {
      "type": "integer",
      "minimum": 8,
      "maximum": 12
    },
    "polygonal_face_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "polygonal_wall_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximum_compressive_stress_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimum_stress_n_mm2": {
      "type": "number"
    },
    "design_yield_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "working_condition_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "external_loads_and_combinations_confirmed": {
      "type": "boolean",
      "const": true
    }
  }
}
