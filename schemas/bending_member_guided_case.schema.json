{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bending_member_guided_case.schema.json",
  "title": "SP16 Stage N4 guided bending member",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "standard",
    "action",
    "beam_category",
    "member_class",
    "load_is_static",
    "section_weakening",
    "moment_x_n_mm",
    "moment_y_n_mm",
    "bimoment_n_mm2",
    "minimum_net_section_modulus_x_mm3",
    "minimum_net_section_modulus_y_mm3",
    "inertia_x_mm4",
    "inertia_y_mm4",
    "compressed_section_modulus_x_mm3",
    "compressed_section_modulus_y_mm3",
    "section_height_mm",
    "web_thickness_mm",
    "flange_width_mm",
    "flange_thickness_mm",
    "flange_axis_spacing_mm",
    "effective_web_height_mm",
    "torsional_inertia_mm4",
    "normative_yield_resistance_n_mm2",
    "design_yield_resistance_n_mm2",
    "design_shear_resistance_n_mm2",
    "elastic_modulus_n_mm2",
    "working_condition_factor",
    "shear_force_x_n",
    "shear_force_y_n",
    "web_has_bolt_holes",
    "rolled_i_section_confirmed",
    "lateral_stability",
    "local_stability"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017"
    },
    "action": {
      "type": "string",
      "const": "bending_member_guided"
    },
    "beam_category": {
      "type": "string",
      "enum": [
        "ordinary",
        "crane_runway",
        "bimetal"
      ]
    },
    "member_class": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "load_is_static": {
      "type": "boolean"
    },
    "section_weakening": {
      "type": "string",
      "enum": [
        "none",
        "explicit_net_properties"
      ]
    },
    "moment_x_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "moment_y_n_mm": {
      "type": "number",
      "minimum": 0
    },
    "bimoment_n_mm2": {
      "type": "number",
      "minimum": 0
    },
    "minimum_net_section_modulus_x_mm3": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "minimum_net_section_modulus_y_mm3": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "inertia_x_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "inertia_y_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "compressed_section_modulus_x_mm3": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "section_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "web_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flange_width_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flange_thickness_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flange_axis_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "effective_web_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "torsional_inertia_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "first_moment_area_x_mm3": {
      "type": "number",
      "minimum": 0
    },
    "first_moment_area_y_mm3": {
      "type": "number",
      "minimum": 0
    },
    "web_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "one_flange_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "flange_to_web_area_ratio": {
      "type": "number",
      "minimum": 0
    },
    "normative_yield_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "design_yield_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "design_shear_resistance_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "elastic_modulus_n_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "working_condition_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "shear_force_x_n": {
      "type": "number",
      "minimum": 0
    },
    "shear_force_y_n": {
      "type": "number",
      "minimum": 0
    },
    "web_has_bolt_holes": {
      "type": "boolean"
    },
    "hole_pitch_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "hole_diameter_mm": {
      "type": "number",
      "minimum": 0
    },
    "rolled_i_section_confirmed": {
      "type": "boolean"
    },
    "net_inertia_x_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "net_inertia_y_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "net_sectorial_inertia_mm6": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "point_x_mm": {
      "type": "number"
    },
    "point_y_mm": {
      "type": "number"
    },
    "sectorial_coordinate_mm2": {
      "type": "number"
    },
    "minimum_net_sectorial_section_modulus_mm4": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "plastic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section_family": {
          "type": "string",
          "enum": [
            "i_section",
            "box_section"
          ]
        },
        "table_e1_section_type": {
          "type": "string",
          "enum": [
            "1",
            "2",
            "3",
            "4",
            "5a",
            "5b",
            "6",
            "7",
            "8a",
            "8b",
            "9a",
            "9b"
          ]
        },
        "equivalent_load_safety_factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "required_clause_checks_confirmed": {
          "type": "boolean"
        },
        "is_support_section": {
          "type": "boolean"
        },
        "class_3_confirmations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clause_8_2_5_confirmed": {
              "type": "boolean"
            },
            "clause_8_4_6_confirmed": {
              "type": "boolean"
            },
            "clause_8_5_8_confirmed": {
              "type": "boolean"
            },
            "clause_8_5_9_confirmed": {
              "type": "boolean"
            },
            "clause_8_5_18_confirmed": {
              "type": "boolean"
            },
            "maximum_moment_sections_include_shear_effect": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "concentrated_load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "force_n": {
          "type": "number",
          "minimum": 0
        },
        "figure_6_case": {
          "type": "string",
          "enum": [
            "welded_or_rolled",
            "crane_wheel"
          ]
        },
        "bearing_width_mm": {
          "type": "number",
          "minimum": 0
        },
        "flange_and_weld_or_fillet_height_mm": {
          "type": "number",
          "minimum": 0
        },
        "distribution_coefficient_psi": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "flange_and_rail_inertia_mm4": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "lateral_stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "not_assessed",
            "rigid_deck_exemption",
            "table_11_exemption",
            "calculate_phi_b"
          ]
        },
        "effective_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "load_position": {
          "type": "string",
          "enum": [
            "upper_flange",
            "lower_flange",
            "between_braces_or_pure_bending"
          ]
        },
        "friction_flange_connections": {
          "type": "boolean"
        },
        "compressed_flange_stress_n_mm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "tension_to_compression_flange_width_ratio": {
          "type": "number",
          "minimum": 0
        },
        "compression_flange_braced_in_span": {
          "type": "boolean"
        },
        "annex_zh_table": {
          "type": "string",
          "enum": [
            "zh1",
            "zh2"
          ]
        },
        "case_id": {
          "type": "string"
        },
        "load_flange": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "compressed",
            "tension",
            null
          ]
        }
      }
    },
    "local_stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "not_assessed",
            "geometry_and_stiffener_screen"
          ]
        },
        "moving_flange_load_present": {
          "type": "boolean"
        },
        "plastic_deformation_region": {
          "type": "boolean"
        },
        "class_1_extended_spacing_conditions_met": {
          "type": "boolean"
        },
        "local_stress_present": {
          "type": "boolean"
        },
        "double_sided_flange_welds": {
          "type": "boolean"
        }
      }
    },
    "compressed_section_modulus_y_mm3": {
      "type": "number",
      "exclusiveMinimum": 0
    }
  }
}
