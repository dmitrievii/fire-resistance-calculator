  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017 «Стальные конструкции»"
    },
    "action": {
      "type": "string",
      "const": "antenna_structures"
    },
    "section_17_applicability_confirmed": {
      "type": "boolean",
      "const": true
    },
    "structure_height_m": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 500
    },
    "component_group": {
      "type": "integer",
      "enum": [
        1,
        2,
        3
      ]
    },
    "steel_grade": {
      "type": "string",
      "minLength": 1
    },
    "is_pipe": {
      "type": "boolean"
    },
    "annex_v_grade_selection_confirmed": {
      "type": "boolean",
      "const": true
    },
    "rope_design_force_kn": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rope_environment": {
      "type": "string",
      "enum": [
        "non_aggressive",
        "mild",
        "medium",
        "strong"
      ]
    },
    "rope_construction": {
      "type": "string",
      "enum": [
        "spiral_nonspinning",
        "round_strand_nonspinning_double_cross",
        "locked_coil",
        "spinning"
      ]
    },
    "rope_core_type": {
      "type": "string",
      "enum": [
        "metallic",
        "nonmetallic"
      ]
    },
    "built_in_nut_insulator": {
      "type": "boolean"
    },
    "radio_allows_nonmetallic_core": {
      "type": "boolean"
    },
    "round_wire_rope_capacity_kn": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "end_binding_length_increased_25_percent": {
      "type": "boolean"
    },
    "selected_rope_end_alloy": {
      "type": "string"
    },
    "annex_b_table_b2_selection_confirmed": {
      "type": "boolean",
      "const": true
    },
    "copper_wire_used": {
      "type": "boolean"
    },
    "technological_necessity_confirmed": {
      "type": "boolean"
    },
    "wire_breaking_force_n": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "wire_type": {
      "type": "string",
      "enum": [
        "aluminium",
        "copper",
        "steel_aluminium",
        "bimetal_steel_copper"
      ]
    },
    "wire_nominal_area_mm2": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "table_47_case_id": {
      "type": "string",
      "enum": [
        "PRESTRESSED_LATTICE_MEMBER",
        "RING_TYPE_FLANGE",
        "OTHER_FLANGE_TYPE",
        "GUY_OR_ANTENNA_ELEMENT_COUNT_3_TO_5",
        "GUY_COUNT_6_TO_8",
        "GUY_COUNT_9_OR_MORE",
        "THIMBLE_CLAMPS_OR_POINT_CRIMP",
        "ROPE_SPLICE_ON_THIMBLE_OR_INSULATOR",
        "GUY_OR_ANTENNA_ATTACHMENT_ELEMENT",
        "ANCHOR_ROD_TENSION_WITH_BENDING_NO_THREAD",
        "EYE_PLATE_IN_TENSION",
        "ROPE_ATTACHMENT_MECHANICAL_DETAIL_EXCEPT_HINGE_PIN",
        "HINGE_PIN_IN_BEARING"
      ]
    },
    "actual_support_deviation_mm": {
      "type": "number",
      "minimum": 0
    },
    "support_height_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "support_deviation_load_case": {
      "type": "string",
      "enum": [
        "wind_or_ice",
        "unilateral_antenna_no_wind"
      ]
    },
    "erection_accuracy_class": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "erection_bolt_strength_class": {
      "type": "string",
      "enum": [
        "8.8",
        "10.9"
      ]
    },
    "sign_changing_force": {
      "type": "boolean"
    },
    "controlled_pretension_confirmed": {
      "type": "boolean"
    },
    "erection_weld_used": {
      "type": "boolean"
    },
    "installer_agreement_confirmed": {
      "type": "boolean"
    },
    "cross_brace_slenderness": {
      "type": "number",
      "minimum": 0
    },
    "cross_braces_tied_at_intersection": {
      "type": "boolean"
    },
    "platform_vertical_deflection_mm": {
      "type": "number",
      "minimum": 0
