    "platform_horizontal_deflection_mm": {
      "type": "number",
      "minimum": 0
    },
    "platform_span_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "actual_diaphragm_spacing_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "mean_support_section_size_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "diaphragm_at_concentrated_loads": {
      "type": "boolean"
    },
    "diaphragm_at_chord_breaks": {
      "type": "boolean"
    },
    "flange_bolts_on_one_circle": {
      "type": "boolean"
    },
    "flange_bolt_circle_minimum_diameter": {
      "type": "boolean"
    },
    "flange_bolts_equally_spaced": {
      "type": "boolean"
    },
    "members_centered_on_chord_axis": {
      "type": "boolean"
    },
    "node_eccentricity_mm": {
      "type": "number",
      "minimum": 0
    },
    "chord_cross_section_size_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "node_moment_analysis_performed": {
      "type": "boolean"
    },
    "slot_end_hole_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "round_brace_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "guy_centered_at_chord_strut_intersection": {
      "type": "boolean"
    },
    "eye_plate_stiffened_against_bending": {
      "type": "boolean"
    },
    "attachment_exceeds_transport_envelope": {
      "type": "boolean"
    },
    "separate_rigid_insert_provided": {
      "type": "boolean"
    },
    "flexible_insert_clear_length_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rope_diameter_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "standard_mechanical_detail_used": {
      "type": "boolean"
    },
    "mechanical_detail_strength_tested": {
      "type": "boolean"
    },
    "mechanical_detail_fatigue_tested": {
      "type": "boolean"
    },
    "threaded_tension_element": {
      "type": "boolean"
    },
    "rounded_thread_root_confirmed": {
      "type": "boolean"
    },
    "rope_pretension_n": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rope_mass_per_length_kg_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rope_span_m": {
      "type": "number",
      "exclusiveMinimum": 0
