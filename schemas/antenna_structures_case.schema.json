    "low_frequency_damper_hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "high_frequency_damper_hz": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "paired_sequential_dampers": {
      "type": "boolean"
    },
    "low_frequency_selected_from_fundamental_mode": {
      "type": "boolean"
    },
    "high_frequency_damper_above_low_at_distance_s": {
      "type": "boolean"
    },
