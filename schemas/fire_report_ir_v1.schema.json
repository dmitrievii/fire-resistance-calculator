{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fire_report_ir_v1.schema.json",
  "title": "FIRE REPORT-IR1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract",
    "graph_id",
    "graph_sha256",
    "session_schema",
    "session_status",
    "entry_node_id",
    "current_node_id",
    "block_count",
    "blocks",
    "audit",
    "report_sha256"
  ],
  "properties": {
    "schema": {"const": "fire_report_ir_v1"},
    "contract": {"const": "dag_trace_projection_v1"},
    "graph_id": {"type": ["string", "null"]},
    "graph_sha256": {"type": ["string", "null"]},
    "session_schema": {"type": ["string", "null"]},
    "session_status": {"type": ["string", "null"]},
    "entry_node_id": {"type": ["string", "null"]},
    "current_node_id": {"type": ["string", "null"]},
    "block_count": {"type": "integer", "minimum": 0},
    "blocks": {
      "type": "array",
      "items": {"$ref": "#/$defs/reportBlock"}
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calculation_values_recomputed_by_report",
        "normal_block_value_source",
        "dag_metadata_is_authoritative",
        "deterministic_order",
        "wall_clock_time_in_identity"
      ],
      "properties": {
        "calculation_values_recomputed_by_report": {"const": false},
        "normal_block_value_source": {"const": "completed_session_trace"},
        "dag_metadata_is_authoritative": {"const": true},
        "deterministic_order": {"type": "string"},
        "wall_clock_time_in_identity": {"const": false}
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "reportValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quantity_id",
        "symbol",
        "name_ru",
        "raw_value",
        "canonical_unit",
        "data_type",
        "source_kind",
        "producer_node_id",
        "execution_sequence",
        "provenance"
      ],
      "properties": {
        "quantity_id": {"type": "string", "minLength": 1},
        "symbol": {"type": ["string", "null"]},
        "name_ru": {"type": "string", "minLength": 1},
        "raw_value": {},
        "canonical_unit": {"type": ["string", "null"]},
        "data_type": {"type": ["string", "null"]},
        "source_kind": {"type": ["string", "null"]},
        "producer_node_id": {"type": "string", "minLength": 1},
        "execution_sequence": {"type": "integer", "minimum": 0},
        "provenance": {"type": ["object", "null"]}
      }
    },
    "reportBlock": {
      "type": "object",
      "required": [
        "schema",
        "report_block_id",
        "owner_node_id",
        "owner_standard_id",
        "sequence",
        "event_kind",
        "kind",
        "section_key",
        "title",
        "normative_refs",
        "inputs",
        "outputs",
        "selected_edge_id",
        "execution_spec",
        "presentation",
        "message"
      ],
      "properties": {
        "schema": {"const": "fire_report_block_v1"},
        "report_block_id": {"type": "string", "minLength": 1},
        "owner_node_id": {"type": "string", "minLength": 1},
        "owner_standard_id": {"type": ["string", "null"]},
        "sequence": {"type": "integer", "minimum": 0},
        "event_kind": {"type": ["string", "null"]},
        "kind": {
          "type": "string",
          "enum": [
            "INPUT",
            "ASSUMPTION",
            "GEOMETRY",
            "FORMULA",
            "TABLE_LOOKUP",
            "INTERPOLATION",
            "BRANCH_DECISION",
            "CHECK",
            "WARNING",
            "FAIL_CLOSED",
            "RESULT"
          ]
        },
        "section_key": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "normative_refs": {"type": "array", "items": {"type": "object"}},
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/reportValue"}},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/reportValue"}},
        "selected_edge_id": {"type": ["string", "null"]},
        "execution_spec": {"type": "object"},
        "presentation": {"type": "object"},
        "message": {"type": ["string", "null"]},
        "failure": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
