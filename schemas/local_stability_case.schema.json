{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local_stability_case.schema.json",
  "title": "СП 16.13330.2017 centrally compressed member local stability case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action", "clause_7_3_applicability_confirmed",
    "table_9_diagram_group", "table_10_diagram_group", "member_relative_slenderness",
    "effective_web_height_mm", "web_thickness_mm", "tee_flange_width_mm",
    "effective_flange_outstand_mm", "flange_thickness_mm",
    "design_yield_resistance_n_mm2", "elastic_modulus_n_mm2",
    "gross_area_mm2", "axial_force_n", "stability_coefficient_phi",
    "edge_stiffened", "two_plane_condition_governs",
    "longitudinal_stiffener_inertia_mm4", "apply_longitudinal_stiffener_multiplier",
    "transverse_stiffener_arrangement", "provided_transverse_stiffener_outstand_mm",
    "geometrically_nonlinear_design", "solid_branch_of_built_up_column",
    "member_reinforced_with_battens", "reduced_area_section_family",
    "effective_box_flange_plate_width_mm", "box_flange_thickness_mm"
  ],
  "properties": {
    "case_id": {"type": "string"},
    "standard": {"type": "string", "const": "СП 16.13330.2017"},
    "action": {"type": "string", "const": "centrally_compressed_local_stability"},
    "clause_7_3_applicability_confirmed": {"type": "boolean", "const": true},
    "table_9_diagram_group": {"type": "string", "enum": ["group_1_i_section", "group_2_box_section", "group_3_channel_section", "group_4_tee_section"]},
    "table_10_diagram_group": {"type": "string", "enum": ["group_1", "group_2", "group_3", "group_4"]},
    "member_relative_slenderness": {"type": "number", "minimum": 0},
    "effective_web_height_mm": {"type": "number", "exclusiveMinimum": 0},
    "web_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "tee_flange_width_mm": {"type": "number", "exclusiveMinimum": 0},
    "effective_flange_outstand_mm": {"type": "number", "exclusiveMinimum": 0},
    "flange_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "design_yield_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "elastic_modulus_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "gross_area_mm2": {"type": "number", "exclusiveMinimum": 0},
    "axial_force_n": {"type": "number", "exclusiveMinimum": 0},
    "stability_coefficient_phi": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "edge_stiffened": {"type": "boolean"},
    "two_plane_condition_governs": {"type": "boolean"},
    "longitudinal_stiffener_inertia_mm4": {"type": "number", "minimum": 0},
    "apply_longitudinal_stiffener_multiplier": {"type": "boolean"},
    "transverse_stiffener_arrangement": {"type": "string", "enum": ["paired_symmetric", "one_sided"]},
    "provided_transverse_stiffener_outstand_mm": {"type": "number", "exclusiveMinimum": 0},
    "geometrically_nonlinear_design": {"type": "boolean"},
    "solid_branch_of_built_up_column": {"type": "boolean"},
    "member_reinforced_with_battens": {"type": "boolean"},
    "reduced_area_section_family": {"type": "string", "enum": ["i_section", "channel_section", "box_section"]},
    "effective_box_flange_plate_width_mm": {"type": "number", "exclusiveMinimum": 0},
    "box_flange_thickness_mm": {"type": "number", "exclusiveMinimum": 0}
  }
}
