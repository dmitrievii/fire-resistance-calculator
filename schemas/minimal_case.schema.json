{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "minimal_case.schema.json",
  "title": "SP 16 material-resistance case supported in v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "standard",
    "action",
    "material_control_category",
    "normative_yield_resistance_n_mm2",
    "normative_ultimate_resistance_n_mm2",
    "normative_weld_metal_ultimate_resistance_n_mm2",
    "normative_bolt_ultimate_resistance_n_mm2",
    "bolt_strength_class",
    "bolt_hole_accuracy_class",
    "connected_steel_yield_strength_n_mm2",
    "rope_breaking_force_n"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "standard": {
      "type": "string",
      "const": "СП 16.13330.2017"
    },
    "action": {
      "type": "string",
      "const": "material_resistance_bundle"
    },
    "material_control_category": {
      "type": "string",
      "enum": [
        "statistical_control",
        "nonstatistical_high_yield_or_hot_finished_or_foreign",
        "other_conforming",
        "ks1_limited_service"
      ]
    },
    "normative_yield_resistance_n_mm2": {
      "type": "number",
      "minimum": 0
    },
    "normative_ultimate_resistance_n_mm2": {
      "type": "number",
      "minimum": 0
    },
    "normative_weld_metal_ultimate_resistance_n_mm2": {
      "type": "number",
      "minimum": 0
    },
    "normative_bolt_ultimate_resistance_n_mm2": {
      "type": "number",
      "minimum": 0
    },
    "bolt_strength_class": {
      "type": "string",
      "enum": [
        "5.6",
        "5.8",
        "8.8",
        "10.9",
        "12.9"
      ]
    },
    "bolt_hole_accuracy_class": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "connected_steel_yield_strength_n_mm2": {
      "type": "number",
      "minimum": 0,
      "maximum": 450
    },
    "rope_breaking_force_n": {
      "type": "number",
      "minimum": 0
    }
  }
}
