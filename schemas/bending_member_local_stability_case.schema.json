{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP 16 bending member local stability case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "standard", "action", "moment_n_mm", "shear_force_n",
    "distance_from_neutral_axis_mm", "major_inertia_mm4", "web_thickness_mm",
    "full_web_height_mm", "effective_web_height_mm", "panel_length_mm",
    "design_yield_resistance_n_mm2", "design_shear_resistance_n_mm2",
    "elastic_modulus_n_mm2", "working_condition_factor", "local_stress_n_mm2",
    "flange_width_mm", "flange_thickness_mm", "beta_factor",
    "table_14_rho", "table_14_panel_ratio", "table_15_delta", "table_15_panel_ratio",
    "flange_outstand_mm", "flange_design_yield_resistance_n_mm2",
    "compressed_flange_stress_n_mm2", "section_class"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "standard": {"const": "СП 16.13330.2017"},
    "action": {"const": "bending_member_local_stability"},
    "moment_n_mm": {"type": "number"},
    "shear_force_n": {"type": "number", "minimum": 0},
    "distance_from_neutral_axis_mm": {"type": "number"},
    "major_inertia_mm4": {"type": "number", "exclusiveMinimum": 0},
    "web_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "full_web_height_mm": {"type": "number", "exclusiveMinimum": 0},
    "effective_web_height_mm": {"type": "number", "exclusiveMinimum": 0},
    "panel_length_mm": {"type": "number", "exclusiveMinimum": 0},
    "design_yield_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "design_shear_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "elastic_modulus_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "working_condition_factor": {"type": "number", "exclusiveMinimum": 0},
    "local_stress_n_mm2": {"type": "number", "minimum": 0},
    "flange_width_mm": {"type": "number", "exclusiveMinimum": 0},
    "flange_thickness_mm": {"type": "number", "exclusiveMinimum": 0},
    "beta_factor": {"type": "number", "exclusiveMinimum": 0},
    "table_14_rho": {"enum": [0.10, 0.15, 0.20, 0.25, 0.30, 0.35, 0.40]},
    "table_14_panel_ratio": {"type": "number", "minimum": 0.5},
    "table_15_delta": {"type": "number", "exclusiveMinimum": 0},
    "table_15_panel_ratio": {"type": "number", "minimum": 0.5},
    "flange_outstand_mm": {"type": "number", "exclusiveMinimum": 0},
    "flange_design_yield_resistance_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "compressed_flange_stress_n_mm2": {"type": "number", "exclusiveMinimum": 0},
    "section_class": {"enum": [1, 2, 3]}
  }
}
