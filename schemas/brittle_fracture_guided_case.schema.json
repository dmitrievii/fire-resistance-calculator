{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"brittle_fracture_guided_case.schema.json",
  "title":"SP16 Stage N10 guided Section 13 brittle-fracture case",
  "type":"object",
  "additionalProperties":false,
  "required":["case_id","standard","action","route"],
  "properties":{
    "case_id":{"type":"string","minLength":1},
    "standard":{"const":"СП 16.13330.2017"},
    "action":{"const":"brittle_fracture_guided"},
    "route":{
      "type":"object",
      "additionalProperties":false,
      "required":[
        "kind","design_yield_resistance_n_mm2","welded_structure",
        "steel_selection_5_2_table_v1_confirmed","stress_concentration_and_work_hardening_reduction_confirmed",
        "solid_web_vs_lattice_concentration_considered","cover_plate_splice_with_flank_welds",
        "guillotine_cutting_or_punched_holes","secondary_gusset_to_tension_member",
        "steel_grade_number","plate_thickness_mm","joint_type","through_thickness_tension",
        "clause_13_3_engineering_review_confirmed","lamellar_tearing_assessment_required"
      ],
      "properties":{
        "kind":{"const":"section13_full_review"},
        "design_yield_resistance_n_mm2":{"type":"number","exclusiveMinimum":0},
        "welded_structure":{"type":"boolean"},
        "steel_selection_5_2_table_v1_confirmed":{"type":"boolean"},
        "stress_concentration_and_work_hardening_reduction_confirmed":{"type":"boolean"},
        "solid_web_vs_lattice_concentration_considered":{"type":"boolean"},
        "weld_zone_tensile_stress_n_mm2":{"type":"number","minimum":0},
        "enhanced_ndt_for_welds_above_0_4_ry_confirmed":{"type":"boolean"},
        "weld_intersections_avoided_confirmed":{"type":"boolean"},
        "runoff_tabs_and_weld_ndt_confirmed":{"type":"boolean"},
        "cover_plate_splice_with_flank_welds":{"type":"boolean"},
        "flank_weld_termination_distance_each_side_mm":{"type":"number","minimum":0},
        "guillotine_cutting_or_punched_holes":{"type":"boolean"},
        "minimum_section_thickness_used_confirmed":{"type":"boolean"},
        "secondary_gusset_to_tension_member":{"type":"boolean"},
        "bolted_secondary_gusset_attachment_confirmed":{"type":"boolean"},
        "steel_grade_number":{"type":"number","exclusiveMinimum":0},
        "plate_thickness_mm":{"type":"number","exclusiveMinimum":0},
        "joint_type":{"enum":["tee","corner","full_penetration","other_welded"]},
        "through_thickness_tension":{"type":"boolean"},
        "clause_13_3_engineering_review_confirmed":{"type":"boolean"},
        "lamellar_tearing_assessment_required":{"type":"boolean"},
        "through_thickness_test_evidence_available":{"type":"boolean"},
        "selected_z_quality_certificate_confirmed":{"type":"boolean"},
        "connection_form_case":{"type":"string","minLength":1},
        "risk_weld_leg_mm":{"type":"number","minimum":0},
        "restraint_level":{"enum":["low_free_shrinkage","medium_partial_shrinkage","high_rigid_no_shrinkage"]},
        "pass_count":{"enum":["one","multiple"]},
        "weld_sequence":{"enum":["alternating_sides","one_side_then_other"]},
        "preheat":{"enum":["without_preheat","with_preheat"]},
        "through_thickness_action":{"enum":["none","static_compression","dynamic_or_vibratory"]},
        "construction_group":{"type":"integer","minimum":1,"maximum":4},
        "consequence_class":{"enum":["KS-1","KS-2","KS-3"]},
        "flange_connection_15_9_10_or_force_normal_to_plate":{"type":"boolean"},
        "selected_z_quality_group":{"enum":["Z15","Z25","Z35"]}
      }
    }
  }
}
