{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SP16 validation corpus case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "title",
    "evidence_class",
    "source",
    "source_reported_inputs",
    "source_reported_checks",
    "source_consistency_findings",
    "validation_classification"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "pattern": "^VAL-SP16-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "original_filename",
        "stored_path",
        "sha256",
        "page_count",
        "preservation"
      ]
    },
    "source_reported_inputs": {
      "type": "object"
    },
    "source_reported_checks": {
      "type": "array",
      "minItems": 1
    },
    "source_consistency_findings": {
      "type": "array"
    },
    "validation_classification": {
      "type": "object",
      "required": [
        "overall_status",
        "count_as_full_end_to_end_golden_case",
        "count_as_scalar_external_replay"
      ]
    }
  },
  "additionalProperties": true
}
